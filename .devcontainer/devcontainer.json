// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "ABE Devcontainer",
	"build": {
		"dockerfile": "./Dockerfile",
		"args": {
			"BASE_IMAGE": "nvidia/cuda:11.8.0-runtime-ubuntu22.04",
			"USERNAME": "abe"
		},
		"context": ".."
	},
	"runArgs": [
		"--net=host",
		"--pid=host",
		"--ipc=host",
		"-e",
		"DISPLAY=${env:DISPLAY}"
	],
	"mounts": [
		"source=${localEnv:HOME}/.ssh,target=/home/abe/.ssh,type=bind,consistency=cached,readonly",
		"source=${localEnv:HOME}/.gitconfig,target=/home/abe/.gitconfig,type=bind,consistency=cached,readonly",
		"source=${localEnv:DATA_HOME},target=/home/abe/data,type=bind,consistency=cached,readonly"
	],

	// Override LD_LIBRARY_PATH and PATH to fix CUDNN
	"remoteEnv": {
		"LD_LIBRARY_PATH": "/home/abe/.local/lib/python3.10/site-packages/nvidia/cublas/lib:/home/abe/.local/lib/python3.10/site-packages/nvidia/cudnn/lib",
		"PATH": "/home/abe/.local/bin:${containerEnv:PATH}",
		"DATA_HOME": "/home/abe/data"
	},

	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"remoteUser": "abe",
	"updateRemoteUserUID": true,
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"redhat.vscode-yaml",
				"redhat.vscode-xml",
				"mutantdino.resourcemonitor",
				"wayou.vscode-todo-highlight",
				"tamasfe.even-better-toml",
				"ms-toolsai.jupyter",
				"charliermarsh.ruff",
				"tomoki1207.pdf"
			]
		}
	},
	"hostRequirements": {
		"gpu": "optional",
		"cpus": 2,
		"memory": "8gb"
	}
}
